[Desktop Entry]
Type=Application
Version=1.0
Name=Aether
GenericName=IDE
Comment=Fast IDE: projects, builds, gdb debugger, LSP and git
Exec=aether %F
Icon=aether
Terminal=false
StartupNotify=true
StartupWMClass=io.github.aether.Editor
Categories=Development;IDE;TextEditor;Utility;
Keywords=editor;code;programming;ide;text;debugger;gdb;c;cpp;rust;python;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-python3;text/x-rust;text/x-go;text/x-java;text/x-script.python;text/x-shellscript;text/x-makefile;text/x-lua;text/x-ruby;text/x-php;text/javascript;application/javascript;application/json;application/x-shellscript;application/xml;text/html;text/css;application/toml;application/x-yaml;text/x-sql;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=aether
