  <snippet _name="Arduino: Serial.begin + println" trigger="inoserial" _description="Arduino: Serial.begin + println">
    <text languages="cpp;"><![CDATA[Serial.begin(${1:115200});
Serial.println("${2:ready}");]]></text>
