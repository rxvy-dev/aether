<snippets _group="Aether">
  <snippet _name="c: starter (main)" trigger="main" _description="c: starter (main)">
    <text languages="c;chdr;"><![CDATA[#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <stdbool.h>

int main(int argc, char *argv[]) {
	${1:printf("Hello, world!\\n");}
	return 0;
}]]></text>
  </snippet>
  <snippet _name="c: for loop" trigger="for" _description="c: for loop">
    <text languages="c;chdr;"><![CDATA[for (size_t ${1:i} = 0; ${1:i} < ${2:n}; ++${1:i}) {
	$0
}]]></text>
  </snippet>
