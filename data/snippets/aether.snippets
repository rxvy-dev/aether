  <snippet _name="makefile: starter (main)" trigger="main" _description="makefile: starter (main)">
    <text languages="makefile;"><![CDATA[CC      ?= cc
CFLAGS  ?= -Wall -Wextra -O2
TARGET  := ${1:app}
SRC     := $(wildcard *.c)

all: $(TARGET)

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $@ $^

clean:
	rm -f $(TARGET)

.PHONY: all clean]]></text>
  </snippet>
  <snippet _name="dockerfile: starter (main)" trigger="main" _description="dockerfile: starter (main)">
    <text languages="docker;"><![CDATA[FROM ${1:debian:stable-slim}

WORKDIR /app
COPY . .

CMD ["${2:./app}"]]]></text>
  </snippet>
