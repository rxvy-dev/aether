<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-fjord-light" name="Fjord Light" version="1.0">
  <author>Aether</author>
  <description>Fjord Light</description>
  <style name="text" foreground="#2e3440" background="#eceff4"/>
  <style name="selection" background="#d8dee9"/>
  <style name="cursor" foreground="#2e3440"/>
  <style name="secondary-cursor" foreground="#8f9bb3"/>
  <style name="current-line" background="#e5e9f0"/>
  <style name="line-numbers" foreground="#8f9bb3" background="#eceff4"/>
  <style name="current-line-number" foreground="#2e3440" background="#e5e9f0" bold="true"/>
  <style name="bracket-match" foreground="#2e3440" background="#d8dee9" bold="true"/>
  <style name="bracket-mismatch" foreground="#bf616a" underline="error"/>
  <style name="right-margin" foreground="#8f9bb3" background="#e5e9f0"/>
  <style name="draw-spaces" foreground="#d8dee9"/>
  <style name="search-match" background="#d8dee9"/>
  <style name="map-overlay" background="#d8dee9"/>
  <style name="def:comment" foreground="#8f9bb3" italic="true"/>
  <style name="def:shebang" foreground="#8f9bb3" bold="true"/>
  <style name="def:doc-comment-element" foreground="#8f9bb3" italic="true" bold="true"/>
  <style name="def:string" foreground="#5f8a49"/>
  <style name="def:special-char" foreground="#4c8a8d"/>
  <style name="def:special-constant" foreground="#8f6a9c"/>
  <style name="def:character" foreground="#5f8a49"/>
  <style name="def:keyword" foreground="#5e81ac"/>
  <style name="def:statement" foreground="#5e81ac"/>
  <style name="def:builtin" foreground="#3b7f98"/>
  <style name="def:type" foreground="#4c8a8d"/>
  <style name="def:function" foreground="#3b7f98"/>
  <style name="def:identifier" foreground="#2e3440"/>
  <style name="def:variable" foreground="#2e3440"/>
  <style name="def:operator" foreground="#5e81ac"/>
  <style name="def:constant" foreground="#8f6a9c"/>
  <style name="def:boolean" foreground="#8f6a9c"/>
  <style name="def:number" foreground="#8f6a9c"/>
  <style name="def:decimal" foreground="#8f6a9c"/>
  <style name="def:base-n-integer" foreground="#8f6a9c"/>
  <style name="def:floating-point" foreground="#8f6a9c"/>
  <style name="def:complex" foreground="#8f6a9c"/>
  <style name="def:preprocessor" foreground="#b8694e"/>
  <style name="def:note" foreground="#a67c1a" bold="true"/>
  <style name="def:warning" foreground="#a67c1a" underline="error"/>
  <style name="def:error" foreground="#bf616a" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:link-symbol" foreground="#3b7f98" underline="single"/>
  <style name="def:link-destination" foreground="#3b7f98" underline="single"/>
  <style name="def:heading" foreground="#5e81ac" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#5f8a49"/>
  <style name="def:net-address" foreground="#3b7f98" underline="single"/>
  <style name="def:reserved" foreground="#5e81ac"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#bf616a"/>
  <style name="diff:changed-line" foreground="#a67c1a"/>
  <style name="diff:special-case" foreground="#b8694e"/>
  <style name="diff:location" foreground="#3b7f98"/>
  <style name="diff:diff-file" foreground="#4c8a8d"/>
</style-scheme>
