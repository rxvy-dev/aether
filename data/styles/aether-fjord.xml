<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-fjord" name="Fjord" version="1.0">
  <author>Aether</author>
  <description>Fjord</description>
  <style name="text" foreground="#d8dee9" background="#2e3440"/>
  <style name="selection" background="#434c5e"/>
  <style name="cursor" foreground="#d8dee9"/>
  <style name="secondary-cursor" foreground="#616e88"/>
  <style name="current-line" background="#3b4252"/>
  <style name="line-numbers" foreground="#616e88" background="#2e3440"/>
  <style name="current-line-number" foreground="#d8dee9" background="#3b4252" bold="true"/>
  <style name="bracket-match" foreground="#d8dee9" background="#434c5e" bold="true"/>
  <style name="bracket-mismatch" foreground="#bf616a" underline="error"/>
  <style name="right-margin" foreground="#616e88" background="#3b4252"/>
  <style name="draw-spaces" foreground="#434c5e"/>
  <style name="search-match" background="#434c5e"/>
  <style name="map-overlay" background="#434c5e"/>
  <style name="def:comment" foreground="#616e88" italic="true"/>
  <style name="def:shebang" foreground="#616e88" bold="true"/>
  <style name="def:doc-comment-element" foreground="#616e88" italic="true" bold="true"/>
  <style name="def:string" foreground="#a3be8c"/>
  <style name="def:special-char" foreground="#8fbcbb"/>
  <style name="def:special-constant" foreground="#b48ead"/>
  <style name="def:character" foreground="#a3be8c"/>
  <style name="def:keyword" foreground="#81a1c1"/>
  <style name="def:statement" foreground="#81a1c1"/>
  <style name="def:builtin" foreground="#88c0d0"/>
  <style name="def:type" foreground="#8fbcbb"/>
  <style name="def:function" foreground="#88c0d0"/>
  <style name="def:identifier" foreground="#d8dee9"/>
  <style name="def:variable" foreground="#d8dee9"/>
  <style name="def:operator" foreground="#81a1c1"/>
  <style name="def:constant" foreground="#b48ead"/>
  <style name="def:boolean" foreground="#b48ead"/>
  <style name="def:number" foreground="#b48ead"/>
  <style name="def:decimal" foreground="#b48ead"/>
  <style name="def:base-n-integer" foreground="#b48ead"/>
  <style name="def:floating-point" foreground="#b48ead"/>
  <style name="def:complex" foreground="#b48ead"/>
  <style name="def:preprocessor" foreground="#d08770"/>
  <style name="def:note" foreground="#ebcb8b" bold="true"/>
  <style name="def:warning" foreground="#ebcb8b" underline="error"/>
  <style name="def:error" foreground="#bf616a" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:link-symbol" foreground="#88c0d0" underline="single"/>
  <style name="def:link-destination" foreground="#88c0d0" underline="single"/>
  <style name="def:heading" foreground="#81a1c1" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#a3be8c"/>
  <style name="def:net-address" foreground="#88c0d0" underline="single"/>
  <style name="def:reserved" foreground="#81a1c1"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#bf616a"/>
  <style name="diff:changed-line" foreground="#ebcb8b"/>
  <style name="diff:special-case" foreground="#d08770"/>
  <style name="diff:location" foreground="#88c0d0"/>
  <style name="diff:diff-file" foreground="#8fbcbb"/>
</style-scheme>
