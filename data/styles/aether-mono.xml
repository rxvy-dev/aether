<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-mono" name="Aether Mono" version="1.0">
  <author>Aether</author>
  <description>Aether Mono</description>
  <style name="text" foreground="#d0d0d0" background="#101010"/>
  <style name="selection" background="#3a3a3a"/>
  <style name="cursor" foreground="#ffffff"/>
  <style name="secondary-cursor" foreground="#666666"/>
  <style name="current-line" background="#181818"/>
  <style name="line-numbers" foreground="#666666" background="#101010"/>
  <style name="current-line-number" foreground="#d0d0d0" background="#181818" bold="true"/>
  <style name="bracket-match" foreground="#ffffff" background="#3a3a3a" bold="true"/>
  <style name="bracket-mismatch" foreground="#ff6b6b" underline="error"/>
  <style name="right-margin" foreground="#666666" background="#181818"/>
  <style name="draw-spaces" foreground="#3a3a3a"/>
  <style name="search-match" background="#3a3a3a"/>
  <style name="map-overlay" background="#3a3a3a"/>
  <style name="def:comment" foreground="#6a6a6a" italic="true"/>
  <style name="def:shebang" foreground="#6a6a6a" bold="true"/>
  <style name="def:doc-comment-element" foreground="#6a6a6a" italic="true" bold="true"/>
  <style name="def:string" foreground="#b5b5b5"/>
  <style name="def:special-char" foreground="#a0a0a0"/>
  <style name="def:special-constant" foreground="#c8c8c8"/>
  <style name="def:character" foreground="#b5b5b5"/>
  <style name="def:keyword" foreground="#ffffff"/>
  <style name="def:statement" foreground="#ffffff"/>
  <style name="def:builtin" foreground="#f0f0f0"/>
  <style name="def:type" foreground="#e0e0e0"/>
  <style name="def:function" foreground="#f0f0f0"/>
  <style name="def:identifier" foreground="#d0d0d0"/>
  <style name="def:variable" foreground="#d0d0d0"/>
  <style name="def:operator" foreground="#8c8c8c"/>
  <style name="def:constant" foreground="#c8c8c8"/>
  <style name="def:boolean" foreground="#c8c8c8"/>
  <style name="def:number" foreground="#c8c8c8"/>
  <style name="def:decimal" foreground="#c8c8c8"/>
  <style name="def:base-n-integer" foreground="#c8c8c8"/>
  <style name="def:floating-point" foreground="#c8c8c8"/>
  <style name="def:complex" foreground="#c8c8c8"/>
  <style name="def:preprocessor" foreground="#9a9a9a"/>
  <style name="def:note" foreground="#e6c07b" bold="true"/>
  <style name="def:warning" foreground="#e6c07b" underline="error"/>
  <style name="def:error" foreground="#ff6b6b" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:link-symbol" foreground="#f0f0f0" underline="single"/>
  <style name="def:link-destination" foreground="#f0f0f0" underline="single"/>
  <style name="def:heading" foreground="#ffffff" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#b5b5b5"/>
  <style name="def:net-address" foreground="#f0f0f0" underline="single"/>
  <style name="def:reserved" foreground="#ffffff"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#ff6b6b"/>
  <style name="diff:changed-line" foreground="#e6c07b"/>
  <style name="diff:special-case" foreground="#9a9a9a"/>
  <style name="diff:location" foreground="#f0f0f0"/>
  <style name="diff:diff-file" foreground="#e0e0e0"/>
</style-scheme>
