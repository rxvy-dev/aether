<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-neon" name="Neon" version="1.0">
  <author>Aether</author>
  <description>Neon</description>
  <style name="text" foreground="#e6e6ff" background="#0b0b14"/>
  <style name="selection" background="#2b2b55"/>
  <style name="cursor" foreground="#ff2bd6"/>
  <style name="secondary-cursor" foreground="#4b4b8a"/>
  <style name="current-line" background="#13132a"/>
  <style name="line-numbers" foreground="#4b4b8a" background="#0b0b14"/>
  <style name="current-line-number" foreground="#e6e6ff" background="#13132a" bold="true"/>
  <style name="bracket-match" foreground="#ff2bd6" background="#2b2b55" bold="true"/>
  <style name="bracket-mismatch" foreground="#ff3860" underline="error"/>
  <style name="right-margin" foreground="#4b4b8a" background="#13132a"/>
  <style name="draw-spaces" foreground="#2b2b55"/>
  <style name="search-match" background="#2b2b55"/>
  <style name="map-overlay" background="#2b2b55"/>
  <style name="def:comment" foreground="#4b4b8a" italic="true"/>
  <style name="def:shebang" foreground="#4b4b8a" bold="true"/>
  <style name="def:doc-comment-element" foreground="#4b4b8a" italic="true" bold="true"/>
  <style name="def:string" foreground="#00ffa3"/>
  <style name="def:special-char" foreground="#00e5ff"/>
  <style name="def:special-constant" foreground="#ffe600"/>
  <style name="def:character" foreground="#00ffa3"/>
  <style name="def:keyword" foreground="#ff2bd6"/>
  <style name="def:statement" foreground="#ff2bd6"/>
  <style name="def:builtin" foreground="#7c5cff"/>
  <style name="def:type" foreground="#00e5ff"/>
  <style name="def:function" foreground="#7c5cff"/>
  <style name="def:identifier" foreground="#e6e6ff"/>
  <style name="def:variable" foreground="#e6e6ff"/>
  <style name="def:operator" foreground="#a0a0ff"/>
  <style name="def:constant" foreground="#ffe600"/>
  <style name="def:boolean" foreground="#ffe600"/>
  <style name="def:number" foreground="#ffe600"/>
  <style name="def:decimal" foreground="#ffe600"/>
  <style name="def:base-n-integer" foreground="#ffe600"/>
  <style name="def:floating-point" foreground="#ffe600"/>
  <style name="def:complex" foreground="#ffe600"/>
  <style name="def:preprocessor" foreground="#ff8a00"/>
  <style name="def:note" foreground="#ffe600" bold="true"/>
  <style name="def:warning" foreground="#ffe600" underline="error"/>
  <style name="def:error" foreground="#ff3860" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:link-symbol" foreground="#7c5cff" underline="single"/>
  <style name="def:link-destination" foreground="#7c5cff" underline="single"/>
  <style name="def:heading" foreground="#ff2bd6" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#00ffa3"/>
  <style name="def:net-address" foreground="#7c5cff" underline="single"/>
  <style name="def:reserved" foreground="#ff2bd6"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#ff3860"/>
  <style name="diff:changed-line" foreground="#ffe600"/>
  <style name="diff:special-case" foreground="#ff8a00"/>
  <style name="diff:location" foreground="#7c5cff"/>
  <style name="diff:diff-file" foreground="#00e5ff"/>
</style-scheme>
