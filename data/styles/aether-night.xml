<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-night" name="Aether Night" version="1.0">
  <author>Aether</author>
  <description>Aether Night</description>
  <style name="text" foreground="#c0caf5" background="#1a1b26"/>
  <style name="selection" background="#33467c"/>
  <style name="cursor" foreground="#c0caf5"/>
  <style name="secondary-cursor" foreground="#565f89"/>
  <style name="current-line" background="#202233"/>
  <style name="line-numbers" foreground="#565f89" background="#1a1b26"/>
  <style name="current-line-number" foreground="#c0caf5" background="#202233" bold="true"/>
  <style name="bracket-match" foreground="#c0caf5" background="#33467c" bold="true"/>
  <style name="bracket-mismatch" foreground="#f7768e" underline="error"/>
  <style name="right-margin" foreground="#565f89" background="#202233"/>
  <style name="draw-spaces" foreground="#33467c"/>
  <style name="search-match" background="#33467c"/>
  <style name="map-overlay" background="#33467c"/>
  <style name="def:comment" foreground="#565f89" italic="true"/>
  <style name="def:shebang" foreground="#565f89" bold="true"/>
  <style name="def:doc-comment-element" foreground="#565f89" italic="true" bold="true"/>
  <style name="def:string" foreground="#9ece6a"/>
  <style name="def:special-char" foreground="#73daca"/>
  <style name="def:special-constant" foreground="#ff9e64"/>
  <style name="def:character" foreground="#9ece6a"/>
  <style name="def:keyword" foreground="#bb9af7"/>
  <style name="def:statement" foreground="#bb9af7"/>
  <style name="def:builtin" foreground="#7aa2f7"/>
  <style name="def:type" foreground="#2ac3de"/>
  <style name="def:function" foreground="#7aa2f7"/>
  <style name="def:identifier" foreground="#c0caf5"/>
  <style name="def:variable" foreground="#c0caf5"/>
  <style name="def:operator" foreground="#89ddff"/>
  <style name="def:constant" foreground="#ff9e64"/>
  <style name="def:boolean" foreground="#ff9e64"/>
  <style name="def:number" foreground="#ff9e64"/>
  <style name="def:decimal" foreground="#ff9e64"/>
  <style name="def:base-n-integer" foreground="#ff9e64"/>
  <style name="def:floating-point" foreground="#ff9e64"/>
  <style name="def:complex" foreground="#ff9e64"/>
  <style name="def:preprocessor" foreground="#e0af68"/>
  <style name="def:note" foreground="#e0af68" bold="true"/>
  <style name="def:warning" foreground="#e0af68" underline="error"/>
  <style name="def:error" foreground="#f7768e" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:link-symbol" foreground="#7aa2f7" underline="single"/>
  <style name="def:link-destination" foreground="#7aa2f7" underline="single"/>
  <style name="def:heading" foreground="#bb9af7" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#9ece6a"/>
  <style name="def:net-address" foreground="#7aa2f7" underline="single"/>
  <style name="def:reserved" foreground="#bb9af7"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#f7768e"/>
  <style name="diff:changed-line" foreground="#e0af68"/>
  <style name="diff:special-case" foreground="#e0af68"/>
  <style name="diff:location" foreground="#7aa2f7"/>
  <style name="diff:diff-file" foreground="#2ac3de"/>
</style-scheme>
