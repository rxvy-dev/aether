  <style name="def:special-constant" foreground="#eb6f92"/>
  <style name="def:character" foreground="#f6c177"/>
  <style name="def:keyword" foreground="#c4a7e7"/>
  <style name="def:statement" foreground="#c4a7e7"/>
  <style name="def:builtin" foreground="#ebbcba"/>
  <style name="def:type" foreground="#9ccfd8"/>
  <style name="def:function" foreground="#ebbcba"/>
  <style name="def:identifier" foreground="#e0def4"/>
  <style name="def:variable" foreground="#e0def4"/>
  <style name="def:operator" foreground="#908caa"/>
  <style name="def:constant" foreground="#eb6f92"/>
  <style name="def:boolean" foreground="#eb6f92"/>
  <style name="def:number" foreground="#eb6f92"/>
  <style name="def:decimal" foreground="#eb6f92"/>
  <style name="def:base-n-integer" foreground="#eb6f92"/>
  <style name="def:floating-point" foreground="#eb6f92"/>
