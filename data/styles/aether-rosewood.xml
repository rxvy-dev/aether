<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-rosewood" name="Rosewood" version="1.0">
  <author>Aether</author>
  <description>Rosewood</description>
  <style name="text" foreground="#e0def4" background="#1f1d2e"/>
  <style name="selection" background="#403d52"/>
  <style name="cursor" foreground="#e0def4"/>
  <style name="secondary-cursor" foreground="#6e6a86"/>
