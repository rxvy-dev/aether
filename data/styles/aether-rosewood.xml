  <style name="def:heading" foreground="#c4a7e7" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#f6c177"/>
  <style name="def:net-address" foreground="#ebbcba" underline="single"/>
  <style name="def:reserved" foreground="#c4a7e7"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#eb6f92"/>
  <style name="diff:changed-line" foreground="#f6c177"/>
  <style name="diff:special-case" foreground="#f6c177"/>
  <style name="diff:location" foreground="#ebbcba"/>
  <style name="diff:diff-file" foreground="#9ccfd8"/>
