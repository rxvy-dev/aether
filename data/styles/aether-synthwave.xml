<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="aether-synthwave" name="Synthwave" version="1.0">
  <author>Aether</author>
  <description>Synthwave</description>
  <style name="text" foreground="#f5e9ff" background="#1a1033"/>
  <style name="selection" background="#3d2667"/>
  <style name="cursor" foreground="#ff3df2"/>
  <style name="secondary-cursor" foreground="#7a64a8"/>
  <style name="current-line" background="#22164a"/>
  <style name="line-numbers" foreground="#7a64a8" background="#1a1033"/>
  <style name="current-line-number" foreground="#f5e9ff" background="#22164a" bold="true"/>
  <style name="bracket-match" foreground="#ff3df2" background="#3d2667" bold="true"/>
  <style name="bracket-mismatch" foreground="#fe4450" underline="error"/>
  <style name="right-margin" foreground="#7a64a8" background="#22164a"/>
  <style name="draw-spaces" foreground="#3d2667"/>
  <style name="search-match" background="#3d2667"/>
  <style name="map-overlay" background="#3d2667"/>
  <style name="def:comment" foreground="#7a64a8" italic="true"/>
  <style name="def:shebang" foreground="#7a64a8" bold="true"/>
  <style name="def:doc-comment-element" foreground="#7a64a8" italic="true" bold="true"/>
  <style name="def:string" foreground="#fffb96"/>
  <style name="def:special-char" foreground="#36f9f6"/>
  <style name="def:special-constant" foreground="#ff8b39"/>
  <style name="def:character" foreground="#fffb96"/>
  <style name="def:keyword" foreground="#ff3df2"/>
  <style name="def:statement" foreground="#ff3df2"/>
  <style name="def:builtin" foreground="#72f1b8"/>
  <style name="def:type" foreground="#36f9f6"/>
  <style name="def:function" foreground="#72f1b8"/>
  <style name="def:identifier" foreground="#f5e9ff"/>
  <style name="def:variable" foreground="#f5e9ff"/>
  <style name="def:operator" foreground="#d7b8ff"/>
  <style name="def:constant" foreground="#ff8b39"/>
  <style name="def:boolean" foreground="#ff8b39"/>
  <style name="def:number" foreground="#ff8b39"/>
  <style name="def:decimal" foreground="#ff8b39"/>
  <style name="def:base-n-integer" foreground="#ff8b39"/>
  <style name="def:floating-point" foreground="#ff8b39"/>
  <style name="def:complex" foreground="#ff8b39"/>
  <style name="def:preprocessor" foreground="#fe4450"/>
  <style name="def:note" foreground="#fffb96" bold="true"/>
  <style name="def:warning" foreground="#fffb96" underline="error"/>
  <style name="def:error" foreground="#fe4450" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:link-symbol" foreground="#72f1b8" underline="single"/>
  <style name="def:link-destination" foreground="#72f1b8" underline="single"/>
  <style name="def:heading" foreground="#ff3df2" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#fffb96"/>
  <style name="def:net-address" foreground="#72f1b8" underline="single"/>
  <style name="def:reserved" foreground="#ff3df2"/>
  <style name="diff:added-line" foreground="#6bd36b"/>
  <style name="diff:removed-line" foreground="#fe4450"/>
  <style name="diff:changed-line" foreground="#fffb96"/>
  <style name="diff:special-case" foreground="#fe4450"/>
  <style name="diff:location" foreground="#72f1b8"/>
  <style name="diff:diff-file" foreground="#36f9f6"/>
</style-scheme>
